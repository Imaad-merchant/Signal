rules_version = '2';

// Owner-only security rules for Signal.
//
// Deploy with:  firebase deploy --only firestore:rules
//
// Every document is scoped to its owner via the `userId` field. Reads/writes are
// allowed only when the requester is signed in AND owns the document. Creates are
// allowed only when the new document's `userId` matches the requester's uid.
// Anything not explicitly matched below is denied by the final catch-all rule.

service cloud.firestore {
  match /databases/{database}/documents {

    // Owner-only access for a collection:
    //  - read/delete require ownership of the existing doc.
    //  - create requires the incoming doc to be owned by the caller.
    //  - update requires ownership AND that the doc stays owned by the caller
    //    (so a user can never re-assign a document to another uid).
    function isOwner() {
      return request.auth != null && request.auth.uid == resource.data.userId;
    }
    function isCreatingOwner() {
      return request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    function canUpdate() {
      return isOwner() && request.resource.data.userId == request.auth.uid;
    }

    // Existing app collections
    match /tasks/{docId} {
      allow read, delete: if isOwner();
      allow update: if canUpdate();
      allow create: if isCreatingOwner();
    }
    match /categories/{docId} {
      allow read, delete: if isOwner();
      allow update: if canUpdate();
      allow create: if isCreatingOwner();
    }
    match /dailyLogs/{docId} {
      allow read, delete: if isOwner();
      allow update: if canUpdate();
      allow create: if isCreatingOwner();
    }
    match /focusSessions/{docId} {
      allow read, delete: if isOwner();
      allow update: if canUpdate();
      allow create: if isCreatingOwner();
    }
    match /pages/{docId} {
      allow read, delete: if isOwner();
      allow update: if canUpdate();
      allow create: if isCreatingOwner();
    }

    // Jarvis layer collections
    match /domains/{docId} {
      allow read, delete: if isOwner();
      allow update: if canUpdate();
      allow create: if isCreatingOwner();
    }
    match /memory/{docId} {
      allow read, delete: if isOwner();
      allow update: if canUpdate();
      allow create: if isCreatingOwner();
    }
    match /check_ins/{docId} {
      allow read, delete: if isOwner();
      allow update: if canUpdate();
      allow create: if isCreatingOwner();
    }
    match /commitments/{docId} {
      allow read, delete: if isOwner();
      allow update: if canUpdate();
      allow create: if isCreatingOwner();
    }
    match /insights/{docId} {
      allow read, delete: if isOwner();
      allow update: if canUpdate();
      allow create: if isCreatingOwner();
    }
    match /news_topics/{docId} {
      allow read, delete: if isOwner();
      allow update: if canUpdate();
      allow create: if isCreatingOwner();
    }
    match /agent_actions/{docId} {
      allow read, delete: if isOwner();
      allow update: if canUpdate();
      allow create: if isCreatingOwner();
    }

    // Ingested Gmail/Drive highlights written by the Google poller (server writes
    // via the Admin SDK, which bypasses these rules; the owner reads them here).
    match /signals/{docId} {
      allow read, delete: if isOwner();
      allow update: if canUpdate();
      allow create: if isCreatingOwner();
    }
    // Grade rows (manual paste or the local worker).
    match /grades/{docId} {
      allow read, delete: if isOwner();
      allow update: if canUpdate();
      allow create: if isCreatingOwner();
    }
    // Latest local telemetry pushed by the worker (server writes via Admin SDK;
    // the owner reads it here). One doc per user.
    match /telemetry/{docId} {
      allow read, delete: if isOwner();
      allow update: if canUpdate();
      allow create: if isCreatingOwner();
    }
    // Daily habits + their per-day logs (evening review).
    match /habits/{docId} {
      allow read, delete: if isOwner();
      allow update: if canUpdate();
      allow create: if isCreatingOwner();
    }
    match /habit_logs/{docId} {
      allow read, delete: if isOwner();
      allow update: if canUpdate();
      allow create: if isCreatingOwner();
    }
    // Local knowledge notes indexed by the worker (Obsidian vault / folders).
    match /notes/{docId} {
      allow read, delete: if isOwner();
      allow update: if canUpdate();
      allow create: if isCreatingOwner();
    }
    // Notes queued for the worker to write into the Obsidian vault — server-only.
    match /note_outbox/{docId} {
      allow read, write: if false;
    }
    // Orchestration commands: owner reads results; only the server (Admin SDK) writes.
    match /commands/{docId} {
      allow read, delete: if isOwner();
      allow create, update: if false;
    }
    // Automation reports posted to /api/ingest (server writes via Admin SDK). The
    // owner reads them and updates the "announced" flag once the briefing reads them.
    match /reports/{docId} {
      allow read, delete: if isOwner();
      allow update: if canUpdate();
      allow create: if false;
    }
    // Money tab — owner-scoped financial data (accounts, transactions, subscriptions).
    match /accounts/{docId} {
      allow read, delete: if isOwner();
      allow update: if canUpdate();
      allow create: if isCreatingOwner();
    }
    match /transactions/{docId} {
      allow read, delete: if isOwner();
      allow update: if canUpdate();
      allow create: if isCreatingOwner();
    }
    match /subscriptions/{docId} {
      allow read, delete: if isOwner();
      allow update: if canUpdate();
      allow create: if isCreatingOwner();
    }
    match /budgets/{docId} {
      allow read, delete: if isOwner();
      allow update: if canUpdate();
      allow create: if isCreatingOwner();
    }
    // Google OAuth refresh tokens — written ONLY by the server (Admin SDK). No
    // client access at all: tokens must never be readable from the browser.
    match /google_tokens/{docId} {
      allow read, write: if false;
    }
    // Google Calendar sync cursor (syncToken) — server-only.
    match /gcal_state/{docId} {
      allow read, write: if false;
    }
    // Plaid item access tokens — written ONLY by the server (Admin SDK). Never
    // client-readable: bank access tokens must not reach the browser.
    match /plaid_items/{docId} {
      allow read, write: if false;
    }
    // Web Push subscriptions — written by the server (Admin SDK) after the client
    // hands over its subscription via /api/donna; not client-readable.
    match /push_subscriptions/{docId} {
      allow read, write: if false;
    }

    // Default deny: anything not matched above is rejected.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
