{
  "functions": {
    "api/**": {
      "maxDuration": 60
    }
  },
  "crons": [
    { "path": "/api/ingest?job=morning", "schedule": "0 11 * * *" },
    { "path": "/api/ingest?job=evening", "schedule": "0 23 * * *" },
    { "path": "/api/ingest?job=plaid-sync", "schedule": "0 8 * * *" },
    { "path": "/api/ingest?job=gcal-sync", "schedule": "30 7 * * *" }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
