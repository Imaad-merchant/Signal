{
  "name": "FocusSession",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "description": "Related task ID"
    },
    "task_title": {
      "type": "string",
      "description": "Task title for display"
    },
    "duration_minutes": {
      "type": "number",
      "description": "Duration in minutes"
    },
    "session_type": {
      "type": "string",
      "enum": [
        "focus",
        "break"
      ],
      "default": "focus"
    },
    "completed": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "duration_minutes"
  ]
}